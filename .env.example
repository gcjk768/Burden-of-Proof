# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (https://tokenfactory.nebius.com, profile > API keys)
NEBIUS_API_KEY=
# Needed only for Token Factory Sandboxes
NEBIUS_PROJECT_ID=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model per role. IDs are case-sensitive and are checked against the public catalog.
NEBIUS_MODEL_TRIAGE=nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL_TRIAGE_ALT=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_BUILD=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL_DEEP_FALLBACK=nvidia/nemotron-3-super-120b-a12b

# Optional per-role base URL overrides, for example the us-central1 host for Super and Ultra
# NEBIUS_BASE_URL_DEEP=https://api.tokenfactory.us-central1.nebius.com/v1/
# NEBIUS_BASE_URL_BUILD=https://api.tokenfactory.us-central1.nebius.com/v1/

# Spend controls in US dollars. A run estimated above BOP_WARN_USD needs --yes.
BOP_WARN_USD=2.0
BOP_BUDGET_USD=5.0

# Response cache: readwrite (default), read (replay only), off
BOP_CACHE=readwrite
# Where runs, the cache and the Maven repository live
BOP_HOME=.bop
# Optional shared Maven repository for all runs (defaults to $BOP_HOME/m2)
# BOP_MAVEN_REPO=~/.cache/bop-m2

# Later milestones
TAVILY_API_KEY=
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
